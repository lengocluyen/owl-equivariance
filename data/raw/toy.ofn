Prefix(:=<http://example.org/test#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(skos:=<http://www.w3.org/2004/02/skos/core#>)

Ontology(<http://example.org/test>

 Declaration(Class(:Person))
 Declaration(Class(:Employee))
 Declaration(Class(:Professor))
 Declaration(Class(:Lecturer))
 Declaration(Class(:Student))
 Declaration(Class(:GraduateStudent))
 Declaration(Class(:Organization))
 Declaration(Class(:University))
 Declaration(Class(:Company))
 Declaration(Class(:Department))
 Declaration(Class(:Course))
 Declaration(Class(:Publication))
 Declaration(Class(:AcademicStaff))
 Declaration(Class(:ResearchGroup))

 Declaration(ObjectProperty(:worksFor))
 Declaration(ObjectProperty(:employedBy))
 Declaration(ObjectProperty(:teaches))
 Declaration(ObjectProperty(:memberOf))
 Declaration(ObjectProperty(:partOf))
 Declaration(ObjectProperty(:authorOf))

 Declaration(AnnotationProperty(skos:definition))
 Declaration(AnnotationProperty(skos:altLabel))

 Declaration(NamedIndividual(:Alice))
 Declaration(NamedIndividual(:Bob))
 Declaration(NamedIndividual(:Carol))
 Declaration(NamedIndividual(:UTC))
 Declaration(NamedIndividual(:CS101))

 SubClassOf(:Employee :Person)
 SubClassOf(:Student :Person)
 SubClassOf(:AcademicStaff :Employee)
 SubClassOf(:Professor :AcademicStaff)
 SubClassOf(:Lecturer :AcademicStaff)
 SubClassOf(:GraduateStudent :Student)
 SubClassOf(:University :Organization)
 SubClassOf(:Company :Organization)
 SubClassOf(:Department :Organization)
 SubClassOf(:ResearchGroup :Organization)

 SubClassOf(:Professor ObjectSomeValuesFrom(:worksFor :University))
 SubClassOf(:Lecturer ObjectSomeValuesFrom(:worksFor :Organization))
 SubClassOf(:AcademicStaff ObjectSomeValuesFrom(:teaches :Course))
 SubClassOf(:GraduateStudent ObjectSomeValuesFrom(:memberOf :ResearchGroup))
 SubClassOf(ObjectSomeValuesFrom(:worksFor :Organization) :Employee)
 SubClassOf(:Department ObjectSomeValuesFrom(:partOf :University))

 SubObjectPropertyOf(:worksFor :memberOf)
 SubObjectPropertyOf(:employedBy :worksFor)
 ObjectPropertyDomain(:worksFor :Person)
 ObjectPropertyRange(:worksFor :Organization)
 ObjectPropertyDomain(:teaches :Person)
 ObjectPropertyRange(:teaches :Course)
 ObjectPropertyDomain(:authorOf :Person)
 ObjectPropertyRange(:authorOf :Publication)

 ClassAssertion(:Professor :Alice)
 ClassAssertion(:GraduateStudent :Bob)
 ClassAssertion(:Lecturer :Carol)
 ClassAssertion(:University :UTC)
 ClassAssertion(:Course :CS101)
 ObjectPropertyAssertion(:worksFor :Alice :UTC)
 ObjectPropertyAssertion(:teaches :Carol :CS101)

 AnnotationAssertion(rdfs:label :Person "person")
 AnnotationAssertion(rdfs:label :Employee "employee")
 AnnotationAssertion(rdfs:label :Professor "professor")
 AnnotationAssertion(rdfs:label :Lecturer "lecturer")
 AnnotationAssertion(rdfs:label :Student "student")
 AnnotationAssertion(rdfs:label :GraduateStudent "graduate student")
 AnnotationAssertion(rdfs:label :Organization "organization")
 AnnotationAssertion(rdfs:label :University "university")
 AnnotationAssertion(rdfs:label :Company "company")
 AnnotationAssertion(rdfs:label :Department "department")
 AnnotationAssertion(rdfs:label :Course "course")
 AnnotationAssertion(rdfs:label :Publication "publication")
 AnnotationAssertion(rdfs:label :AcademicStaff "academic staff")
 AnnotationAssertion(rdfs:label :ResearchGroup "research group")
 AnnotationAssertion(rdfs:label :worksFor "works for")
 AnnotationAssertion(rdfs:label :teaches "teaches")
 AnnotationAssertion(rdfs:label :memberOf "member of")

 AnnotationAssertion(rdfs:comment :Professor "A member of academic staff holding a chair.")
 AnnotationAssertion(skos:definition :AcademicStaff "An employee whose duties include teaching.")
 AnnotationAssertion(skos:altLabel :Professor "prof")
)
